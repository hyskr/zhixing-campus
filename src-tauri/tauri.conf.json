{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "知行 Campus",
  "version": "0.12.3",
  "identifier": "cn.zhixing.bjtu",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "知行 · 我的交大校园",
        "width": 1380,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 720,
        "center": true,
        "backgroundColor": "#ffffff",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "交大校园，尽在知行",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../licenses": "licenses",
      "../THIRD_PARTY.md": "THIRD_PARTY.md",
      "../SOURCES.md": "SOURCES.md",
      "../BEUI.md": "BEUI.md",
      "../beui.components.json": "beui.components.json"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDNUJBNkYzNUFCMkRENzkKUldSNTNiSmE4NlpiekcySno5eFVCSTJEZ0JLYTdqK0xSQUZSWVJCVVU3RWMrWFZFMThqUXlUL2wK",
      "endpoints": [
        "https://github.com/hyskr/zhixing-campus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
